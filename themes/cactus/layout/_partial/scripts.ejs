<!-- visitor location: show current visitor's region (ipinfo.io, homepage only) -->
<script type="text/javascript">
$(function() {
  var $loc = $("#visitor-location");
  if (!$loc.length) { return; }

  var CN_CITIES = {"Beijing":"北京","Shanghai":"上海","Guangzhou":"广州","Shenzhen":"深圳","Chengdu":"成都","Hangzhou":"杭州","Wuhan":"武汉","Nanjing":"南京","Xi'an":"西安","Chongqing":"重庆","Tianjin":"天津","Suzhou":"苏州","Qingdao":"青岛","Dalian":"大连","Xiamen":"厦门","Changsha":"长沙","Zhengzhou":"郑州","Hefei":"合肥","Jinan":"济南","Fuzhou":"福州","Kunming":"昆明","Harbin":"哈尔滨","Shenyang":"沈阳","Taiyuan":"太原","Shijiazhuang":"石家庄","Nanning":"南宁","Guiyang":"贵阳","Lanzhou":"兰州","Urumqi":"乌鲁木齐","Hohhot":"呼和浩特","Yinchuan":"银川","Xining":"西宁","Lhasa":"拉萨","Haikou":"海口"};

  fetch("https://ipinfo.io/json")
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var country = data.country || "";
      try {
        country = new Intl.DisplayNames(["zh-CN"], { type: "region" }).of(country);
      } catch (e) {}
      var city = CN_CITIES[data.city] || data.city || "";
      $loc.text("欢迎来自 " + [country, city].filter(Boolean).join(" · ") + " 的访客");
      $loc.show();
    })
    .catch(function() {
      $loc.hide();
    });
});
</script>
<!-- back to top floating button -->
<script type="text/javascript">
$(function() {
  var $toTop = $("#to-top");
  if ($toTop.length) {
    $(window).on("scroll", function() {
      if ($(this).scrollTop() > 300) {
        $toTop.fadeIn(150);
      } else {
        $toTop.fadeOut(150);
      }
    });
    $toTop.on("click", function() {
      $("html, body").animate({ scrollTop: 0 }, "fast");
      return false;
    });
  }
});
</script>
<!-- wechat share (QR code) + copy link -->
<script type="text/javascript">
$(function() {
  var pageUrl = <%- JSON.stringify(page.permalink) %>;
  var $tip = $("<div id='copy-tip' style='display:none'></div>").appendTo("body");

  function copyTip(text) {
    $tip.text(text).fadeIn(200);
    setTimeout(function() { $tip.fadeOut(400); }, 2200);
  }

  function fallbackCopy(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand("copy"); copyTip("链接已复制，可粘贴到任意平台"); } catch (e) {}
    document.body.removeChild(ta);
  }

  // copy link button
  $(".share-copy-btn").on("click", function() {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(pageUrl).then(function() {
        copyTip("链接已复制，可粘贴到任意平台");
      }).catch(function() {
        fallbackCopy(pageUrl);
      });
    } else {
      fallbackCopy(pageUrl);
    }
    return false;
  });

  // wechat: show a QR code of the article url
  $(".share-wechat-btn").on("click", function() {
    var $qr = $(this).closest("ul").siblings(".wechat-qr");
    if ($qr.is(":visible")) {
      $qr.hide();
    } else {
      $qr.find("img").attr("src", "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=" + encodeURIComponent(pageUrl));
      $qr.show();
    }
    return false;
  });
});
</script>